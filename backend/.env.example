# Plantilla de configuracion: copiar a backend/.env y reemplazar sin subirla a GitHub
NODE_ENV=development
APP_PORT=3001
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sigpmat_dev
PGUSER=sigpmat_app
PGPASSWORD=REEMPLAZAR_CON_PASSWORD_LOCAL
# JWT_SECRET: generar 48 bytes aleatorios, expresados como 96 digitos hexadecimales.
# Ejemplo de generacion (sin copiar al repositorio): node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_96_DIGITOS_HEXADECIMALES
